name: '${PLUGIN_NAME}'
version: '${project.version}'
main: '${MAIN_CLASS}'
api-version: '${API_VERSION}'
#if ($DESCRIPTION)
description: '${DESCRIPTION.replace("'", "''")}'
#end
#if ($LOG_PREFIX)
prefix: '${LOG_PREFIX.replace("'", "''")}'
#end
#if ($LOAD_AT)
load: ${LOAD_AT}
#end
#if ($AUTHORS)
authors: [#foreach ($author in $AUTHORS)'${author.replace("'", "''")}'#if ($foreach.hasNext), #end#end]
#end
#if ($WEBSITE)
website: '${WEBSITE.replace("'", "''")}'
#end
#if ($INCLUDE_PLUGIN_LOADER)
#if ($USE_PAPER_MANIFEST)
loader: ${MAIN_CLASS.packageName}.${MAIN_CLASS.className}Loader
#else
paper-plugin-loader: ${MAIN_CLASS.packageName}.${MAIN_CLASS.className}Loader
#end
#end
